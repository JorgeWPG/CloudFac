// ============================================================
// CloudFac - Prisma Schema
// SaaS de Facturación Electrónica para Perú
// Arquitectura: Multi-Tenant con Clean Architecture
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  OWNER        // Dueño de la cuenta
  ADMIN        // Administrador
  ACCOUNTANT   // Contador
  STAFF        // Operador básico
}

/// Tipos de comprobante según catálogo SUNAT
enum TipoComprobante {
  FACTURA       // Código SUNAT: 01
  BOLETA        // Código SUNAT: 03
  NOTA_CREDITO  // Código SUNAT: 07
  NOTA_DEBITO   // Código SUNAT: 08
  RECIBO        // Código SUNAT: 99
}

/// Tipos de documento de identidad según catálogo SUNAT
enum TipoDocumento {
  RUC        // Código: 6 — personas jurídicas
  DNI        // Código: 1 — personas naturales
  CE         // Código: 4 — Carnet de Extranjería
  PASAPORTE  // Código: 7
  OTROS      // Código: 0
}

/// Estado de la respuesta SUNAT / NubeFact
enum SunatEstado {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  OBSERVADO
  ANULADO
  BAJA_PENDIENTE
  DE_BAJA
}

/// Estado interno del comprobante
enum InvoiceEstado {
  BORRADOR   // Sin enviar a SUNAT
  EMITIDO    // Enviado y aceptado
  ANULADO    // Baja en SUNAT
}

/// Métodos de pago
enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_CREDITO
  TARJETA_DEBITO
  YAPE
  PLIN
  CHEQUE
  DEPOSITO
  OTROS
}

/// Estado del pago
enum PaymentEstado {
  PENDIENTE
  COMPLETADO
  RECHAZADO
  REEMBOLSADO
}

// ============================================================
// TENANT — Cuenta SaaS (suscriptor del sistema)
// ============================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique  // Subdominio o identificador único
  plan      PlanType @default(FREE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  users          User[]
  companies      Company[]
  customers      Customer[]
  products       Product[]
  invoices       Invoice[]
  invoiceItems   InvoiceItem[]
  payments       Payment[]
  establishments Establishment[]
  series         Serie[]
}

// ============================================================
// AUTH — NextAuth v5 compatible
// ============================================================

model User {
  id            String    @id @default(cuid())
  tenantId      String
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(STAFF)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  accounts Account[]
  sessions Session[]

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// COMPANY — Empresa emisora con RUC
// ============================================================

/// Empresa registrada con RUC ante SUNAT.
/// Una cuenta (Tenant) puede gestionar múltiples empresas.
model Company {
  id              String   @id @default(cuid())
  tenantId        String

  // Datos SUNAT obligatorios
  ruc             String   // 11 dígitos
  razonSocial     String
  nombreComercial String?

  // Dirección fiscal
  direccion       String?
  ubigeo          String?  // Código ubigeo SUNAT (6 dígitos)
  urbanizacion    String?
  departamento    String?
  provincia       String?
  distrito        String?

  // Contacto
  telefono        String?
  email           String?
  web             String?

  // Branding
  logoUrl         String?  // URL S3 del logo

  // NubeFact credentials (por empresa)
  nubefactToken   String?  // Token de API NubeFact
  nubefactUrl     String?  // URL base NubeFact (producción / beta)

  // Detracción — Banco de la Nación
  /// Número de cuenta en el Banco de la Nación para depósito de detracciones
  detraccionCuentaBn String?

  // Configuración tributaria global
  /// Tasa de IGV por defecto para esta empresa (ej. 18.00). Aplica a nuevos productos/ítems.
  tasaIgvDefecto  Decimal  @default(18) @db.Decimal(5, 2)

  // Credenciales SIRE (Sistema Integrado de Registros Electrónicos)
  /// Usuario SOL de SUNAT para SIRE
  sunatUsuario    String?
  /// Clave SOL de SUNAT para SIRE (almacenar cifrada en producción)
  sunatClave      String?
  /// Client ID OAuth2 para integración SIRE
  sireClientId    String?
  /// Client Secret OAuth2 para integración SIRE (almacenar cifrada en producción)
  sireClientSecret String?

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  establishments Establishment[]
  series         Serie[]
  customers      Customer[]
  products       Product[]
  invoices       Invoice[]

  @@unique([tenantId, ruc])
  @@index([tenantId])
}

// ============================================================
// ESTABLISHMENT — Establecimiento SUNAT (4 dígitos)
// ============================================================

/// Establecimiento anexo de la empresa.
/// El código "0000" corresponde a la casa matriz.
model Establishment {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String

  /// Código de 4 dígitos asignado por SUNAT (ej: "0000", "0001")
  codigoSunat String

  descripcion String?
  direccion   String?
  ubigeo      String?
  telefono    String?

  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])
  series   Serie[]
  invoices Invoice[]

  @@unique([companyId, codigoSunat])
  @@index([tenantId])
  @@index([companyId])
}

// ============================================================
// SERIE — Series de comprobantes SUNAT
// ============================================================

/// Serie correlativa por tipo de comprobante.
/// Factura: F001, Boleta: B001, NC: FC01, etc.
model Serie {
  id              String          @id @default(cuid())
  tenantId        String
  companyId       String
  establishmentId String?

  tipoComprobante   TipoComprobante
  /// Serie alfanumérica (ej: F001, B001, FC01, FD01)
  serieAlfanumerica String
  /// Último número de correlativo emitido
  correlativo       Int             @default(0)
  /// Padding del correlativo (ej: 8 → "00000001")
  correlativoPad    Int             @default(8)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  company       Company        @relation(fields: [companyId], references: [id])
  establishment Establishment? @relation(fields: [establishmentId], references: [id])
  invoices      Invoice[]

  @@unique([companyId, tipoComprobante, serieAlfanumerica])
  @@index([tenantId])
  @@index([companyId])
}

// ============================================================
// CUSTOMER — Clientes / Receptores del comprobante
// ============================================================

model Customer {
  id              String        @id @default(cuid())
  tenantId        String
  companyId       String

  tipoDocumento   TipoDocumento @default(RUC)
  numeroDocumento String
  razonSocial     String
  nombreComercial String?
  direccion       String?
  email           String?
  telefono        String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])
  invoices Invoice[]

  @@unique([companyId, tipoDocumento, numeroDocumento])
  @@index([tenantId])
  @@index([companyId])
}

// ============================================================
// PRODUCT — Productos y Servicios
// ============================================================

/// Catálogo de productos y servicios del negocio.
/// Soporta control de stock solo para productos físicos.
model Product {
  id          String  @id @default(cuid())
  tenantId    String
  companyId   String

  // Identificación
  codigo      String? // Código interno del negocio
  /// Código del producto según catálogo SUNAT (catálogo 25)
  codigoSunat String?

  descripcion  String
  /// Unidad de medida SUNAT (NIU=Unidad, ZZ=Servicio, KGM=Kilogramo, etc.)
  unidadMedida String  @default("NIU")

  // Tipo de producto
  /// true = Servicio (no tiene stock), false = Producto físico
  isService    Boolean @default(false)
  /// Activar control de inventario. Solo válido si isService = false
  stockControl Boolean @default(false)

  // Inventario (solo aplica si stockControl = true)
  stock        Decimal @default(0) @db.Decimal(12, 4)
  stockMinimo  Decimal @default(0) @db.Decimal(12, 4)

  // Precios
  /// Precio sin IGV
  precio       Decimal @db.Decimal(12, 4)
  /// Precio con IGV incluido
  precioConIgv Decimal @db.Decimal(12, 4)
  /// Porcentaje de IGV (default 18%)
  igvPorcentaje Decimal @default(18) @db.Decimal(5, 2)
  /// Tipo de afectación IGV — Catálogo 07 SUNAT
  /// 10=Gravado Op. Onerosa, 20=Exonerado, 30=Inafecto
  afectacionIgv String  @default("10")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([tenantId])
  @@index([companyId])
}

// ============================================================
// INVOICE — Comprobante Electrónico (Factura/Boleta/NC/ND)
// ============================================================

/// Comprobante electrónico emitido y enviado a SUNAT vía NubeFact.
model Invoice {
  id              String  @id @default(cuid())
  tenantId        String
  companyId       String
  establishmentId String?
  serieId         String
  customerId      String

  // Identificación del comprobante
  tipoComprobante  TipoComprobante
  /// Serie del comprobante (ej: F001)
  serie            String
  /// Correlativo sin padding (ej: 1234)
  correlativo      String
  /// Número completo con padding (ej: F001-00001234)
  numeroCompleto   String

  // Fechas
  fechaEmision     DateTime  @default(now())
  fechaVencimiento DateTime?

  // Moneda
  /// Código ISO 4217: PEN (Soles), USD (Dólares)
  moneda           String    @default("PEN")
  tipoCambio       Decimal   @default(1) @db.Decimal(10, 4)

  // Totales (en moneda del comprobante)
  totalGravado     Decimal   @db.Decimal(12, 2)
  totalExonerado   Decimal   @default(0) @db.Decimal(12, 2)
  totalInafecto    Decimal   @default(0) @db.Decimal(12, 2)
  totalGratuito    Decimal   @default(0) @db.Decimal(12, 2)
  totalIgv         Decimal   @db.Decimal(12, 2)
  totalDescuento   Decimal   @default(0) @db.Decimal(12, 2)
  /// Importe total de venta
  totalVenta       Decimal   @db.Decimal(12, 2)

  // Integración NubeFact / SUNAT
  nubefactEnviado    Boolean  @default(false)
  /// Respuesta JSON completa de la API NubeFact
  nubefactRespuesta  Json?
  /// URL S3 del archivo CDR (Constancia de Recepción SUNAT)
  nubefactCdrUrl     String?
  /// URL S3 del PDF del comprobante
  nubefactPdfUrl     String?
  /// URL S3 del XML del comprobante
  nubefactXmlUrl     String?
  /// Hash del XML para verificación de integridad
  nubefactHash       String?
  sunatEstado        SunatEstado @default(PENDIENTE)
  sunatDescripcion   String?

  // Detracción SPOT (Sistema de Pago de Obligaciones Tributarias)
  /// Indica si el comprobante está afecto al sistema de detracciones
  afectoDetraccion      Boolean  @default(false)
  /// Código del bien/servicio según Catálogo 54 SUNAT (ej: "022", "027")
  codigoDetraccion      String?
  /// Porcentaje de detracción aplicable (ej: 12.00 para 12%)
  porcentajeDetraccion  Decimal? @db.Decimal(5, 2)
  /// Importe de la detracción = totalVenta × (porcentajeDetraccion / 100)
  montoDetraccion       Decimal? @db.Decimal(12, 2)
  /// Medio de pago detracción según TABLA 1 SUNAT (001=Depósito, 003=Transferencia, etc.)
  medioPagoDetraccion   String?

  // Para Notas de Crédito / Débito
  /// Número completo del comprobante afectado (ej: F001-00001234)
  documentoRelacionado String?
  /// Motivo de la nota (catálogo 09/10 SUNAT)
  motivoNota           String?

  // Estado interno y observaciones
  estado  InvoiceEstado @default(BORRADOR)
  notas   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  company       Company        @relation(fields: [companyId], references: [id])
  establishment Establishment? @relation(fields: [establishmentId], references: [id])
  serie_rel     Serie          @relation(fields: [serieId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([companyId, tipoComprobante, serie, correlativo])
  @@index([tenantId])
  @@index([companyId])
  @@index([customerId])
  @@index([sunatEstado])
  @@index([estado])
  @@index([fechaEmision])
}

// ============================================================
// INVOICE ITEM — Líneas de detalle del comprobante
// ============================================================

model InvoiceItem {
  id        String  @id @default(cuid())
  tenantId  String
  invoiceId String
  productId String?

  orden        Int     // Posición en el comprobante
  descripcion  String
  /// Unidad de medida SUNAT
  unidadMedida String  @default("NIU")
  cantidad     Decimal @db.Decimal(12, 4)

  // Precios unitarios
  /// Precio unitario sin IGV
  precioUnitario Decimal @db.Decimal(12, 6)
  /// Precio unitario con IGV
  precioConIgv   Decimal @db.Decimal(12, 6)
  descuento      Decimal @default(0) @db.Decimal(12, 4)

  // Tributación
  igvPorcentaje Decimal @default(18) @db.Decimal(5, 2)
  /// Catálogo 07 SUNAT
  afectacionIgv String  @default("10")
  /// Código SUNAT del producto (catálogo 25)
  codigoSunat   String?

  // Totales de la línea
  totalBaseImponible Decimal @db.Decimal(12, 2)
  totalIgv           Decimal @db.Decimal(12, 2)
  totalItem          Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
}

// ============================================================
// PAYMENT — Pagos del comprobante con soporte S3
// ============================================================

/// Registro de pagos asociados a un comprobante.
/// Los vouchers de pago (capturas, constancias) se almacenan en AWS S3.
model Payment {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  metodoPago MetodoPago
  monto      Decimal    @db.Decimal(12, 2)
  /// Código ISO 4217
  moneda     String     @default("PEN")
  tipoCambio Decimal    @default(1) @db.Decimal(10, 4)
  fechaPago  DateTime   @default(now())
  /// Número de operación, código de transacción, CCI, etc.
  referencia String?

  // Voucher almacenado en AWS S3
  /// URL pública (o pre-signed) del voucher en S3
  voucherUrl  String?
  /// Key del objeto en S3 (para generar pre-signed URLs o eliminarlo)
  voucherS3Key String?

  notas  String?
  estado PaymentEstado @default(COMPLETADO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([fechaPago])
}
